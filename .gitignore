# =============================================
# Profilis — profiler artifacts (never commit)
# ---------------------------------------------------------------------------
# Profilis is a high-performance non-blocking profiler for Python web apps
# (Flask, FastAPI, Sanic, SQLAlchemy).
#   PyPI:  pip install profilis
#   GitHub: https://github.com/ankan97dutta/profilis
# ---------------------------------------------------------------------------
# JSONL exporter log directory — configurable via PROFILIS_LOG_DIR env var
# or the project .profilic config (backend/.profilic).
data/profilis/
backend/data/profilis/
logs/
backend/logs/

# Profilis runtime cache and dashboard state
.profilis-cache/
profilis-cache/
.profilis-dashboard/
profilis-dashboard/

# Profilis config — local per-machine profiler settings, never commit
.profilic
**/.profilic

# Profilis test/scratch artifacts
.profilis-test/
test-profilis/

# =============================================
# Local agent skill installs (npx skills add)
# =============================================
.agents/
.claude/
skills-lock.json

