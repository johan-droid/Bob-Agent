# Heroku process model (app root = backend/, see docs/CLOUD_HEROKU.md).
# Single uvicorn worker: Basic dynos have 512MB — gunicorn multi-worker
# would exceed quota. PYTHONPATH=src resolves the src-layout package
# without requiring an installed wheel.

# web: HTTP API + Telegram webhook receiver + recovery/outbox scheduler + inline execution.
web: PYTHONPATH=src python -m uvicorn agent_system.api.main:app --host 0.0.0.0 --port ${PORT:-8000}

# release: database migrations before every deploy (safe + idempotent).
release: PYTHONPATH=src python -m alembic upgrade head
