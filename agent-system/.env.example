# ---- LLM Providers (fill what you have; system must boot without them) ----
# Each provider is optional. Configure the ones you want; the setup wizard
# (`agentctl setup`) generates .env.local for you interactively.
# Provider            Env var              Base URL                     Model
# OpenAI              OPENAI_API_KEY       https://api.openai.com/v1    gpt-4o-mini
# Anthropic           ANTHROPIC_API_KEY    https://api.anthropic.com/v1 claude-sonnet-4-5
# Groq (free tier)    GROQ_API_KEY         https://api.groq.com/openai/v1  llama-3.3-70b-versatile
# Ollama (local,no key) -                  http://localhost:11434/v1    llama3.2
# OpenRouter (free)   OPENROUTER_API_KEY   https://openrouter.ai/api/v1 meta-llama/llama-3.3-70b-instruct:free
# Together AI (free)  TOGETHER_API_KEY     https://api.together.xyz/v1  meta-llama/Llama-3.3-70B-Instruct-Turbo-Free
# Mistral (free)      MISTRAL_API_KEY      https://api.mistral.ai/v1    open-mistral-7b
# Gemini (free)       GEMINI_API_KEY       https://generativelanguage.googleapis.com/v1beta  gemini-2.0-flash
# DeepSeek            DEEPSEEK_API_KEY     https://api.deepseek.com/v1  deepseek-chat
# HuggingFace (free)  HUGGINGFACE_API_KEY  https://router.huggingface.co/hf-inference/v1  meta-llama/Llama-3.2-3B-Instruct
# TokenRouter         TOKENROUTER_API_KEY  https://api.tokenrouter.io/v1 auto

# Default model routing. Set DEFAULT_PROVIDER to your chosen provider key;
# DEFAULT_MODEL defaults to that provider's default. Leave unset for echo mode.
DEFAULT_PROVIDER=echo
# DEFAULT_MODEL=

# Extra headers sent with every provider call (JSON). "Proper headers" escape
# hatch for providers with unusual auth requirements.
# PROVIDER_EXTRA_HEADERS='{"X-API-Key":"abc","User-Agent":"bob-agent/0.1"}'

# OpenRouter branding headers (not required, improves provider analytics):
OPENROUTER_SITE_URL=https://localhost
OPENROUTER_APP_NAME=Bob Agent

# ---- Core ----
AGENT_ENV=dev
API_PORT=8000
API_SESSION_SECRET=change-me-to-a-long-random-string
# Secret used to mint the bootstrap auth token via POST /api/v1/auth/token
AGENT_BOOTSTRAP_SECRET=change-me-to-a-long-random-string

# ---- Dashboard ----
# Base URL of the FastAPI backend for the Next.js proxy (web/src/app/api/v1/**)
AGENT_SYSTEM_API_URL=http://127.0.0.1:8000

# ---- Storage ----
DATABASE_URL=sqlite:///data/agent_system.db
VAULT_PATH=/home/ashutoshsahoo/Downloads/Claude memory
WORKSPACES_DIR=workspaces
TEMPLATES_DIR=templates
RECORDINGS_DIR=recordings
OUTPUTS_DIR=outputs
# Agent skills: folders of SKILL.md files (Hermes-style). Users and agents can
# add skills here; per-skill toggles live in skills/.state.json and
# skills/<name>/config.local.yaml so SKILL.md itself stays pristine.
SKILLS_DIR=skills
# Agent soul: identity file injected as <identity> on every model call.
# Empty = auto-discover ./SOUL.md, then parent-dir SOUL.md.
# SOUL_PATH=/path/to/SOUL.md

# ---- Tools (ReAct loop + shell policy) ----
TOOLS_SHELL_MODE=sandbox
TOOLS_REQUIRE_APPROVAL=true
TOOLS_MAX_ITERS=8
# TOOLS_FS_ROOTS=
# Folder-drop tool plugins (same pattern as skills; .state.json toggles).
TOOLS_PLUGIN_DIR=tools_plugins

# ---- Memory ----
MEMORY_AUTO_REMEMBER=true
MEMORY_RECALL_TOP_K=3
# Embedding backend: hash (zero-dep offline default) or local
# (needs: pip install agent-system[memory]).
MEMORY_EMBEDDING_PROVIDER=hash

# ---- ReAct context budget ----
MAX_CONTEXT_TOKENS=100000
CONTEXT_COMPACTION_THRESHOLD_PCT=75.0

# ---- Provider circuit breaker ----
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60

# ---- Backups (nightly APScheduler job in the API server) ----
BACKUPS_DIR=backups
BACKUP_RETENTION_COUNT=7
BACKUP_SCHEDULE_CRON=0 3 * * *

# ---- Agent-to-agent handoff (off by default) ----
A2A_ENABLED=false

# ---- Telemetry (off by default; needs agent-system[telemetry]) ----
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---- Telegram gateway (optional) ----
# Create a bot with @BotFather to get a token. Approved chat ids (comma-separated)
# are the ONLY ids the bot will respond to — auth is enforced per-message.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
# Leave TELEGRAM_WEBHOOK_SECRET empty => long-polling mode (dev).
# Set it => webhook mode; point Telegram webhook at /api/v1/telegram/webhook
#   with header X-Telegram-Webhook-Secret set to this value.
# TELEGRAM_WEBHOOK_SECRET=

# ---- Cost ----
DAILY_BUDGET_USD=10.00

# ---- Resource limits (v3.1 §30) ----
MAX_CONCURRENT_AGENTS=8
MAX_CONCURRENT_TASKS=16
MAX_WORKSPACE_SIZE_MB=512
MAX_FILE_SIZE_MB=10
MAX_OUTPUT_SIZE_MB=50
MAX_LOG_SIZE_MB=100
MAX_BROWSER_SESSIONS=3
MAX_CONTAINER_CPU=2.0
MAX_CONTAINER_MEMORY_MB=2048
MAX_EXECUTION_TIME_SECONDS=1800
MAX_TASK_TOKENS=200000
MAX_TASK_COST_USD=2.00
MAX_RETRIES=3

# ---- OpenConnector (oomol-lab/open-connector) ----
# Self-hosted connector gateway: 1,000+ SaaS providers via Actions + MCP.
# Run one with:  docker compose up openconnector  (listens on :3000)
# Unset base URL = the openconnector_* tools stay hidden.
# OPENCONNECTOR_BASE_URL=http://localhost:3000
# OPENCONNECTOR_RUNTIME_TOKEN=          # Bearer token for /v1 + /mcp (optional locally)
# OPENCONNECTOR_ADMIN_TOKEN=            # admin API: action guides + console (optional)
# OPENCONNECTOR_ALIAS=                  # named connection (x-oo-connector-alias, optional)

# ---- MCP servers (Model Context Protocol) ----
# stdio entry: {"name": "fs", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]}
# HTTP entry:  {"name": "remote", "url": "https://host/mcp", "headers": {"Authorization": "Bearer ..."}}
# When OPENCONNECTOR_BASE_URL is set, an implicit "openconnector" HTTP MCP
# server is added automatically — no entry needed here.
#
# Bob ships its own vault server: it keeps the Obsidian vault updated and
# maintains the dedicated Bob Agent record (records/bob-agent.md). Every call
# goes through mcp_list/mcp_call, so it is approval-gated and audit-logged.
# MCP_SERVERS='[{"name": "vault", "command": "uv", "args": ["run", "bob-vault-mcp"], "cwd": "agent-system/backend"}]'
# MCP_SERVERS='[]'
