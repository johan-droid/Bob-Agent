# =============================================
# Runtime Databases & State (Never commit)
# =============================================
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm

# =============================================
# Bob Agent Dynamic Directories (Preserve .gitkeep and README.md)
# =============================================
workspaces/*
!workspaces/.gitkeep
!workspaces/README.md
backend/workspaces/*
!backend/workspaces/.gitkeep

templates/*
!templates/.gitkeep
!templates/README.md
backend/templates/*
!backend/templates/.gitkeep

recordings/*
!recordings/.gitkeep
!recordings/README.md

outputs/*
!outputs/.gitkeep
!outputs/README.md

vault/*
!vault/.gitkeep
!vault/README.md

backups/*
!backups/.gitkeep
!backups/README.md

